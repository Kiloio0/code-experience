int dfn[N],low[N],tim;
int stk[N],top;
bool in[N];
int scc[N],cnt;

void tarjan(int u){
	dfn[u]=low[u]=++tim;
	stk[++top]=u;
	in[u]=1;

	for(int v:g[u]){
		if(!dfn[v]){
			tarjan(v);
			low[u]=min(low[u],low[v]);
		}
		else if(in[v]){
			low[u]=min(low[u],dfn[v]);
		}
	}

	if(dfn[u]==low[u]){
		++cnt;
		while(1){
			int v=stk[top--];
			in[v]=0;
			scc[v]=cnt;
			if(v==u) break;
		}
	}
}

for(int i=1;i<=n;i++)
	if(!dfn[i])
		tarjan(i);
