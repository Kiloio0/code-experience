#include <bits/stdc++.h>
using namespace std;
int n,tot,head[1509],nex[15009],to[15009],dp[1509][2];
void add(int u,int v){
	to[++tot]=v,nex[tot]=head[u],head[u]=tot;
}
void dfs(int u,int fa){
	  dp[u][1]=1,dp[u][0]=0;
	  for(int i=head[u]; i; i=nex[i]){
	  		if(to[i]==fa) continue;
	  		int v=to[i];
	  		dfs(v,u);
	  		dp[u][0]+=dp[v][1];
	  		dp[u][1]+=min(dp[v][1],dp[v][0]);
	  		//cout<<u<<" "<<dp[u][0]<<" "<<dp[u][1]<<endl;
	  }
}
int main(){
	cin>>n;
	for(int i=1; i<=n; i++){
		int x,u,v;
		cin>>u>>x;
		for(int j=1; j<=x; j++){
			cin>>v;
			add(u,v),add(v,u);
		}
	}
	dfs(0,-1);
	cout<<min(dp[0][0],dp[0][1]);
	return 0;
}
