#include <bits/stdc++.h>
using namespace std;
int n,b,a[3835],dp[3835][3835][2],ans;
int main(){
	cin>>n>>b;
	for(int i=1; i<=n; i++){
		cin>>a[i];
	}
	memset(dp,-0x3f,sizeof(dp));
	dp[1][0][0]=0,dp[1][1][1]=0;
	for(int i=2; i<=n; i++){
		dp[i][0][0]=dp[i-1][0][0];
		for(int j=1; j<=b; j++){
			dp[i][j][0]=max(dp[i-1][j][0],dp[i-1][j][1]);
			dp[i][j][1]=max(dp[i-1][j-1][0],dp[i-1][j-1][1]+a[i]);
		}
	}
	ans=max(dp[n][b][0],dp[n][b][1]);
	memset(dp,-0x3f,sizeof(dp));
	dp[1][0][0]=0,dp[1][1][1]=a[1];
	for(int i=2; i<=n; i++){
		dp[i][0][0]=dp[i-1][0][0];
		for(int j=1; j<=b; j++){
			dp[i][j][0]=max(dp[i-1][j][0],dp[i-1][j][1]);
			dp[i][j][1]=max(dp[i-1][j-1][0],dp[i-1][j-1][1]+a[i]);
		}
	}
	ans=max(ans,dp[n][b][1]);
	cout<<ans;
	return 0;
}
