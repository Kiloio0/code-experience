#include <bits/stdc++.h>
using namespace std;

vector<int> getne(string p){
    int m=p.size();
    vector<int> ne(m);
    for(int i=1,j=0;i<m;i++){
        while(j&&p[i]!=p[j]) j=ne[j-1];
        if(p[i]==p[j]) j++;
        ne[i]=j;
    }
    return ne;
}

vector<int> KMP(string s,string p){
    int n=s.size(),m=p.size();
    vector<int> ne=getne(p),pos;
    for(int i=0,j=0;i<n;i++){
        while(j&&s[i]!=p[j]) j=ne[j-1];
        if(s[i]==p[j]) j++;
        if(j==m){
            pos.push_back(i-m+1);
            j=ne[j-1];
        }
    }
    return pos;
}

int main(){
    ios::sync_with_stdio(false);
    cin.tie(nullptr);
    string s,p;
    cin>>s>>p;
    vector<int> pos=KMP(s,p);
    for(int x:pos) cout<<x<<' ';
    cout<<'\n';
    return 0;
}

#include <bits/stdc++.h>
using namespace std;
const int N=200005,inf=1e9;
int n,m,s,dis[N];
vector<pair<int,int>> g[N];

void bfs01(int s){
    fill(dis,dis+n+1,inf);
    deque<pair<int,int>> q;
    dis[s]=0;
    q.push_front({0,s});
    while(!q.empty()){
        auto [d,u]=q.front();
        q.pop_front();
        if(d!=dis[u]) continue;
        for(auto [v,w]:g[u]){
            if(dis[v]>d+w){
                dis[v]=d+w;
                if(w==0) q.push_front({dis[v],v});
                else q.push_back({dis[v],v});
            }
        }
    }
}

int main(){
    ios::sync_with_stdio(false);
    cin.tie(nullptr);
    cin>>n>>m>>s;
    for(int i=1,u,v,w;i<=m;i++){
        cin>>u>>v>>w;
        g[u].push_back({v,w});
    }
    bfs01(s);
    for(int i=1;i<=n;i++){
        cout<<(dis[i]==inf?-1:dis[i])<<' ';
    }
    cout<<'\n';
    return 0;
}
