int find(int x){
    return fa[x]==x?x:fa[x]=find(fa[x]);
}

for(int i=1;i<=m;i++){
    int u,v;
    cin>>u>>v;
    int fu=find(u),fv=find(v);
    if(fu==fv) cout<<"有环\n";
    else fa[fu]=fv;
}

bool dfs(int u){
    vis[u]=1;
    for(int v:g[u]){
        if(vis[v]==1) return true;
        if(vis[v]==0&&dfs(v)) return true;
    }
    vis[u]=2;
    return false;
}

for(int i=1;i<=n;i++){
    if(!vis[i]&&dfs(i)){
        cout<<"有环\n";
        return 0;
    }
}
cout<<"无环\n";

queue<int> q;
for(int i=1;i<=n;i++){
    if(!in[i]) q.push(i);
}

int cnt=0;
while(!q.empty()){
    int u=q.front();
    q.pop();
    cnt++;

    for(int v:g[u]){
        in[v]--;
        if(!in[v]) q.push(v);
    }
}

if(cnt<n) cout<<"有环\n";
else cout<<"无环\n";
