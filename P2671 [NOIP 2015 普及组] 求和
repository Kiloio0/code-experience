#include <bits/stdc++.h>
using namespace std;
const int mod=10007; 
int n,m,a[100009],c[100009];
long long ans;
vector <long long> cnt[100009][2];
int main(){
	cin>>n>>m;
	for(int i=1; i<=n; i++){
		cin>>a[i];
	}
	for(int i=1; i<=n; i++){
		cin>>c[i];
		cnt[c[i]][i%2].push_back(i);
	}
	for(int i=1; i<=m; i++){
		for(int k=0; k<=1; k++){
			long long sum=0,len=cnt[i][k].size();
			if(len<=1) continue;
			for(auto x:cnt[i][k]){
				sum=(sum+a[x])%mod;
			}
			for(auto x:cnt[i][k]){
				ans=(ans+(x*a[x])%mod*(len-2)%mod)%mod;
				ans=(ans+sum*x%mod)%mod;
			}
		}
	}
	cout<<ans;
	return 0;
}
