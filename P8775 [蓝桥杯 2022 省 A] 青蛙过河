#include <bits/stdc++.h>
using namespace std;
int n,x,h[100009];
long long sum[100009];
bool check(int k){
	for(int i=k; i<n; i++){
		if(sum[i]-sum[i-k]<1ll*2*x) return 0;
	}
	return 1;
}
int main(){
	cin>>n>>x;
	for(int i=1; i<n; i++){
		cin>>h[i];
		sum[i]=sum[i-1]+h[i];
	}
	int mid,l=0,r=n;
	while(l<r){
		mid=(l+r)>>1;
		//cout<<l<<" "<<r<<" "<<mid<<endl;
		if(check(mid)){
			r=mid;
		}
		else{
			l=mid+1;
		}
	}
	cout<<r;
	return 0;
}
