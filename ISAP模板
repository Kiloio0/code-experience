#include <iostream>
#include <stdio.h>
#include <queue>
using namespace std;
const int inf=1000000000;
long long n,m,last[400005],tot=1,cnt[200001],dis[200001],ans,flow,deep[200001],s,t,cur[200001];
queue <int> q;
struct node{
	int y,z,nex;
}e[400005];
inline void add(int x,int y,int z){
	tot++;
	e[tot].y=y,e[tot].z=z,e[tot].nex=last[x],last[x]=tot;
}
inline void bfs(){
	q.push(t);
	dis[t]=1,cnt[1]=1;
	while(!q.empty()){
		int u=q.front();
		q.pop();
		for(int i=last[u]; i; i=e[i].nex){
			int v=e[i].y;
			if(!dis[v]){
				dis[v]=dis[u]+1,cnt[dis[v]]++;
				q.push(v);
			}
		}
	}
}
inline int dfs(int u,int flow){
	int v,temp,delta=0;
	if(u==t){
		ans+=flow;
		return flow;
	}
	for(register int i=cur[u]; i; i=e[i].nex){(int &i=好像更好，尚未实验正确性)
		v=e[i].y,cur[u]=i;
		if(e[i].z>0 && dis[u]==dis[v]+1){
			temp=dfs(v,min(e[i].z,flow-delta));
			e[i].z-=temp,e[i^1].z+=temp,delta+=temp;
			if(flow==delta){
				return delta;
			}
		}
	}
	cnt[dis[u]]--;
	if(cnt[dis[u]]==0){
		dis[s]=n+1;
	}
	dis[u]++,cnt[dis[u]]++,cur[u]=last[u];
	return delta;
}
int main(){
	cin>>n>>m>>s>>t;
	int x,y,z;
	for(register int i=1; i<=m; i++){
		scanf("%d%d%d",&x,&y,&z);
		add(x,y,z),add(y,x,0);
	}
	bfs();
	for(int i=1; i<=n; i++){
		cur[i]=last[i];
	}
	while(dis[s]<=n+1){
		dfs(s,inf);
	}
	cout<<ans;
	return 0;
}
