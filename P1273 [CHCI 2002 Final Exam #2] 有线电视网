#include <bits/stdc++.h>
using namespace std;
int n,m,tot,head[3003],to[30009],nex[30009],w[30009],f[3003][3003],siz[3003];
void add(int u,int v,int c){
	to[++tot]=v,nex[tot]=head[u],head[u]=tot,w[tot]=c;
}
void dfs(int u){
	if(u>=n-m+1){
		siz[u]=1;
		return ;
	}
	for(int i=head[u]; i; i=nex[i]){
		int v=to[i];
		dfs(v);
		siz[u]+=siz[v];
		for(int j=min(m,siz[u]); j>0; j--){
			for(int k=1; k<=siz[v]; k++){
				f[u][j]=max(f[u][j],f[u][j-k]+f[v][k]+w[i]);
			}
		}
	}
}
int main(){
	cin>>n>>m;
	memset(f,-0x3f,sizeof(f));
	for(int i=1; i<=n-m; i++){
		int k,a,c;
		cin>>k;
		for(int j=1; j<=k; j++){
			cin>>a>>c;
			add(i,a,-c);
		}
		f[i][0]=0;
	}
	for(int i=n-m+1; i<=n; i++){
		cin>>f[i][1];
		f[i][0]=0;
	}
	dfs(1);
	for(int i=n; i>=1; i--){
		if(f[1][i]>=0){
			cout<<i;
			return 0;
		}
	}
	return 0;
}
