#include <bits/stdc++.h>
using namespace std;
int t,n,p[33],sg[33],vis[1003];
void SG(){
	for(int i=n; i>0; i--){
		memset(vis,0,sizeof(vis));
		for(int j=i+1; j<=n; j++){
			for(int k=j; k<=n; k++)	{
				vis[sg[j]^sg[k]]=1;
			}
		}
		int op=0;
		while(vis[op]){
			op++;
		}
		sg[i]=op;
	}
}
int main(){
	ios::sync_with_stdio(false);
	cin.tie(nullptr);
	cin>>t;
	while(t--){
		cin>>n;
		SG();
		int ans=0;
		for(int i=1; i<=n; i++){
			cin>>p[i];
			if(p[i]%2){
				ans^=sg[i];
			}
		}
		if(!ans){
			cout<<"-1 -1 -1\n0\n";
			continue;
		}
		int cnt=0;
		for(int i=1; i<=n; i++){
			if(!p[i]) continue;
			for(int j=i+1; j<=n; j++){
				for(int k=j; k<=n; k++){
					if((ans^sg[i]^sg[j]^sg[k])==0){
						cnt++;
						if(cnt==1){
							cout<<i-1<<" "<<j-1<<" "<<k-1<<'\n';
						}
					}
				}
			}
		}
		cout<<cnt<<'\n';
	}
	return 0;
}
