#include <bits/stdc++.h>
using namespace std;

const int N=10005;
const int M=400005;
const long long inf=1e18;

int n,m,s,t,tot=1;
int head[N],pre[N],pe[N],inq[N];
long long dis[N];
queue<int> q;

struct Edge{
    int to,nxt;
    long long cap,cost;
}e[M];

void add(int u,int v,long long c,long long w){
    e[++tot]={v,head[u],c,w};
    head[u]=tot;
    e[++tot]={u,head[v],0,-w};
    head[v]=tot;
}

bool spfa(){
    fill(dis,dis+N,inf);
    memset(inq,0,sizeof(inq));
    while(!q.empty()) q.pop();

    q.push(s);
    dis[s]=0;
    inq[s]=1;

    while(!q.empty()){
        int u=q.front();
        q.pop();
        inq[u]=0;

        for(int i=head[u];i;i=e[i].nxt){
            int v=e[i].to;
            if(e[i].cap>0&&dis[v]>dis[u]+e[i].cost){
                dis[v]=dis[u]+e[i].cost;
                pre[v]=u;
                pe[v]=i;
                if(!inq[v]){
                    q.push(v);
                    inq[v]=1;
                }
            }
        }
    }

    return dis[t]!=inf;
}

pair<long long,long long> mcmf(){
    long long flow=0,cost=0;

    while(spfa()){
        long long f=inf;

        for(int v=t;v!=s;v=pre[v]){
            f=min(f,e[pe[v]].cap);
        }

        for(int v=t;v!=s;v=pre[v]){
            int id=pe[v];
            e[id].cap-=f;
            e[id^1].cap+=f;
        }

        flow+=f;
        cost+=f*dis[t];
    }

    return {flow,cost};
}

int main(){
    ios::sync_with_stdio(false);
    cin.tie(nullptr);

    cin>>n>>m>>s>>t;

    for(int i=1;i<=m;i++){
        int u,v;
        long long c,w;
        cin>>u>>v>>c>>w;
        add(u,v,c,w);
    }

    auto [flow,cost]=mcmf();

    cout<<flow<<" "<<cost<<"\n";
    return 0;
}
