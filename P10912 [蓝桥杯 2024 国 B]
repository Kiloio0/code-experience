#include <bits/stdc++.h>
using namespace std;
long long n,d[100009],l,r,jie[100009],ans,mark[100009],go[100009],injie[100009];
const int mod=1000000007;
long long qsm(long long a,long long b){
	a%=mod;
	long long op=1;
	while(b){
		if(b&1) op=op*a%mod;
		b/=2,a=a*a%mod;
	}
	return op;
}
long long inv(long long a){
	return qsm(a,mod-2);
}
long long c(long long a,long long b){
	if(a<b || a<0 || b<0) return 0;
	return jie[a]*injie[b]%mod*injie[a-b]%mod;
}
long long solve(int x){
	if(mark[x]) return go[x];
	mark[x]=1;
	for(int i=l; i<=r; i++){
		go[x]=(go[x]+c(x,i-1))%mod;
	}
	return go[x];
}
int main(){
	cin>>n;
	for(int i=1; i<n; i++){
		int u,v;
		cin>>u>>v;
		d[u]++,d[v]++;
	}
	cin>>l>>r;
	jie[0]=1,injie[0]=1;
	for(int i=1; i<=n; i++){
		jie[i]=jie[i-1]*i%mod;
		injie[i]=inv(jie[i]);
	}
	for(int i=1; i<=n; i++){
		ans=(ans+solve(d[i]))%mod;
	}
	if(l<=2 && 2<=r) ans=(ans-n+1+mod)%mod;
	cout<<ans;
	return 0;
}
